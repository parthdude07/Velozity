# Server
PORT=5000
NODE_ENV=development

# Database
# Use port 5433 when running via Docker Compose (avoids conflict with local postgres on 5432)
DATABASE_URL="postgresql://postgres:password@localhost:5433/velozity?schema=public"

# JWT
JWT_ACCESS_SECRET=your_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
